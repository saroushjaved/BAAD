# Source-only allowlist. Existing local projects and evidence stay on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/docs/
!/BAAD/
/BAAD/*
!/BAAD/scripts/
!/BAAD/tests/
!/BAAD/common/
!/BAAD/docs/
!/BAAD/analysis/
/BAAD/analysis/*
!/BAAD/analysis/*.m
!/BAAD/analysis/README.md
!/BAAD/BAAD_V1.srcs/
/BAAD/BAAD_V1.srcs/*
!/BAAD/BAAD_V1.srcs/sources_1/
/BAAD/BAAD_V1.srcs/sources_1/*
!/BAAD/BAAD_V1.srcs/sources_1/new/
!/BAAD/BAAD_V1.srcs/sim_1/
/BAAD/BAAD_V1.srcs/sim_1/*
!/BAAD/BAAD_V1.srcs/sim_1/new/
!/BAAD/BAAD_V1.ip_user_files/
/BAAD/BAAD_V1.ip_user_files/*
!/BAAD/BAAD_V1.ip_user_files/mem_init_files/
/BAAD/BAAD_V1.ip_user_files/mem_init_files/*
!/BAAD/BAAD_V1.ip_user_files/mem_init_files/hann_2048_q15.mem
!/BAAD/BAAD_V1.ip_user_files/mem_init_files/ddc_lpf_order128_q15.coe
!/BAAD/baad_serial_firmware/
/BAAD/baad_serial_firmware/*
!/BAAD/baad_serial_firmware/src/
/BAAD/baad_serial_firmware/src/*
!/BAAD/baad_serial_firmware/src/firmware.c
!/BAAD/baad_serial_firmware/tests/
!/BAAD/baad_software_v2/
/BAAD/baad_software_v2/*
!/BAAD/baad_software_v2/src/
/BAAD/baad_software_v2/src/*
!/BAAD/baad_software_v2/src/lscript.ld
!/BAAD_Software_Control_UI/
/BAAD_Software_Control_UI/*
!/BAAD_Software_Control_UI/*.cpp
!/BAAD_Software_Control_UI/*.h
!/BAAD_Software_Control_UI/*.ui
!/BAAD_Software_Control_UI/CMakeLists.txt
!/BAAD_Software_Control_UI/tests/
!/Filter_Designs/
/Filter_Designs/*
!/Filter_Designs/Low_Pass_DDC/
/Filter_Designs/Low_Pass_DDC/*
!/Filter_Designs/Low_Pass_DDC/*.m
!/Filter_Designs/Low_Pass_DDC/*.coe
!/Filter_Designs/Low_Pass_DDC/*coefficients.csv
!/MATLAB_Artifiacts/
/MATLAB_Artifiacts/*
!/MATLAB_Artifiacts/*.m
!/MATLAB_Implementation/
/MATLAB_Implementation/*
!/MATLAB_Implementation/*.m

# Never publish credentials, generated outputs, or editor state.
**/.env*
**/*.pem
**/*.key
**/build/
**/build_*/
**/.Xil/
**/__pycache__/
**/*.pyc
**/*.log
**/*.jou
**/*.exe
**/*.dll
**/*.elf
**/*.bit
**/*.xsa
**/*.dcp
**/*.obj
**/*.user
**/compile_commands.json

# Workstation-only packaging/provenance helpers; retained locally.
/BAAD/scripts/package_release.ps1
/BAAD/scripts/snapshot_baseline.ps1
/BAAD/scripts/tool_help.tcl
/BAAD/docs/PACKAGE_README.md
